# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (core/infrastructure/database) ---
DATABASE_URL="postgresql://user:password@localhost:5432/pao_companion?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pao_companion?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- LLM Providers (core/infrastructure/providers/llm) ---
# PRIMARY — Gemini Flash (biaya rendah, volume percakapan harian)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# FALLBACK / PREMIUM — Claude Sonnet (reliability + momen penting/milestone)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Image Provider (avatar generation, menyusul integrasi penuh) ---
FAL_API_KEY=""

# --- Web app ---
NEXT_PUBLIC_API_URL="http://localhost:3000"
