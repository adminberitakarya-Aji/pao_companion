// PAO Companion — Database Schema
// Phase 3 patch 4: Character diperluas — tambah speechStyle, traits, backstory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PersonaType {
  GIRLFRIEND
  BOYFRIEND
}

enum AvatarStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum MessageRole {
  USER
  COMPANION
}

enum TimelineEventType {
  FIRST_CONVERSATION
  RELATIONSHIP_LEVEL_UP
}

enum SpeechStyle {
  FORMAL
  CASUAL
  PLAYFUL
  SHY
  CONFIDENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companion Companion?

  @@map("users")
}

model Companion {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  personaType PersonaType
  name        String
  appearanceDescription  String
  personalityDescription String?
  speechStyle            SpeechStyle?
  traits                 String[]     @default([])
  backstory               String?
  avatarUrl              String?
  avatarStatus            AvatarStatus @default(PENDING)

  conversation   Conversation?
  memories       Memory[]
  relationship   Relationship?
  timelineEvents TimelineEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companions")
}

model Conversation {
  id          String    @id @default(cuid())
  companionId String    @unique
  companion   Companion @relation(fields: [companionId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id          String    @id @default(cuid())
  companionId String
  companion   Companion @relation(fields: [companionId], references: [id])

  content String

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
  @@map("memories")
}

model Relationship {
  id              String    @id @default(cuid())
  companionId     String    @unique
  companion       Companion @relation(fields: [companionId], references: [id])

  affectionPoints Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("relationships")
}

model TimelineEvent {
  id          String            @id @default(cuid())
  companionId String
  companion   Companion         @relation(fields: [companionId], references: [id])

  eventType   TimelineEventType
  description String

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
  @@map("timeline_events")
}
