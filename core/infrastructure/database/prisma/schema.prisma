// PAO Companion — Database Schema
// Phase 2 patch 1: tambah Conversation + Message untuk vertical slice
// percakapan. User + Companion dari Phase 1 tidak berubah.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PersonaType {
  GIRLFRIEND
  BOYFRIEND
}

enum AvatarStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum MessageRole {
  USER
  COMPANION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companion Companion?

  @@map("users")
}

model Companion {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  personaType PersonaType
  name        String
  appearanceDescription  String
  personalityDescription String?
  avatarUrl              String?
  avatarStatus           AvatarStatus @default(PENDING)

  conversation Conversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companions")
}

model Conversation {
  id          String    @id @default(cuid())
  companionId String    @unique   // 1 companion = 1 conversation berkelanjutan
  companion   Companion @relation(fields: [companionId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  // Index untuk query "ambil N pesan terbaru per conversation" (dipakai
  // MessageRepository.findRecent) — tanpa ini query akan full-scan seiring
  // history bertambah banyak.
  @@index([conversationId, createdAt])
  @@map("messages")
}
