// PAO Companion — Database Schema
// Phase 3 patch 4: Character diperluas — tambah speechStyle, traits, backstory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PersonaType {
  GIRLFRIEND
  BOYFRIEND
}

enum AvatarStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum MessageRole {
  USER
  COMPANION
}

enum TimelineEventType {
  FIRST_CONVERSATION
  RELATIONSHIP_LEVEL_UP
}

enum SpeechStyle {
  FORMAL
  CASUAL
  PLAYFUL
  SHY
  CONFIDENT
}

// Phase 4 — Safety & Trust
enum ModerationCategory {
  SEXUAL_MINOR
  SEXUAL_NONCONSENSUAL
  SELF_HARM_INSTRUCTION
  VIOLENCE_EXTREME
  ILLEGAL_ACTIVITY
  HATE_HARASSMENT
}

enum ModerationAction {
  FLAG
  BLOCK
}

enum ModerationSource {
  USER
  COMPANION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 4 — Safety & Trust
  dateOfBirth         DateTime // wajib >= 18 tahun, divalidasi di domain (User.create) — lihat P4-3
  aiDisclosureAckedAt DateTime? // kapan user meng-ack layar onboarding "companion ini AI" — P4-2
  anonymizedAt        DateTime? // diisi oleh job retensi data (P4-5), null = belum dianonimkan

  companion Companion?

  @@map("users")
}

model Companion {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  personaType PersonaType
  name        String
  appearanceDescription  String
  personalityDescription String?
  speechStyle            SpeechStyle?
  traits                 String[]     @default([])
  backstory               String?
  avatarUrl              String?
  avatarStatus            AvatarStatus @default(PENDING)

  conversation   Conversation?
  memories       Memory[]
  relationship   Relationship?
  timelineEvents TimelineEvent[]
  moderationFlags ModerationFlag[]
  crisisEvents    CrisisEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companions")
}

model Conversation {
  id          String    @id @default(cuid())
  companionId String    @unique
  companion   Companion @relation(fields: [companionId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id          String    @id @default(cuid())
  companionId String
  companion   Companion @relation(fields: [companionId], references: [id])

  content String

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
  @@map("memories")
}

model Relationship {
  id              String    @id @default(cuid())
  companionId     String    @unique
  companion       Companion @relation(fields: [companionId], references: [id])

  affectionPoints Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("relationships")
}

model TimelineEvent {
  id          String            @id @default(cuid())
  companionId String
  companion   Companion         @relation(fields: [companionId], references: [id])

  eventType   TimelineEventType
  description String

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
  @@map("timeline_events")
}

// Phase 4 (P4-1) — audit trail Content Moderator. conversationId/messageId
// nullable karena pesan yang di-block TIDAK PERNAH tersimpan sebagai
// Message (dicegah SEBELUM save) — flag tetap tercatat, tapi tanpa
// referensi ke Message yang memang sengaja tidak pernah ada.
model ModerationFlag {
  id             String             @id @default(cuid())
  companionId    String
  companion      Companion          @relation(fields: [companionId], references: [id])
  conversationId String?
  messageId      String?

  source         ModerationSource
  category       ModerationCategory
  action         ModerationAction
  matchedTerm    String
  contentSnippet String

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
  @@map("moderation_flags")
}

// Phase 4 (P4-4) — audit trail CrisisDetector. Selalu punya
// conversationId karena crisis hanya dievaluasi dalam konteks percakapan
// yang sudah berjalan (beda dari ModerationFlag yang bisa muncul sebelum
// pesan tersimpan).
model CrisisEvent {
  id             String    @id @default(cuid())
  companionId    String
  companion      Companion @relation(fields: [companionId], references: [id])
  conversationId String

  keyword        String
  messageSnippet String

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
  @@map("crisis_events")
}
